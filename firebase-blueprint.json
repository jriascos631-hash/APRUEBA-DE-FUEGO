{
  "entities": {
    "User": {
      "title": "User",
      "description": "Perfil de usuario y ficha de jugador juvenil cristiano",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 80 },
        "lastName": { "type": "string", "maxLength": 80 },
        "username": { "type": "string", "maxLength": 60, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "maxLength": 120 },
        "avatar": { "type": "string", "maxLength": 500 },
        "age": { "type": "number" },
        "birthDate": { "type": "string", "maxLength": 20 },
        "city": { "type": "string", "maxLength": 100 },
        "country": { "type": "string", "maxLength": 100 },
        "church": { "type": "string", "maxLength": 150 },
        "district": { "type": "string", "maxLength": 100 },
        "zone": { "type": "string", "maxLength": 50 },
        "isAdventist": { "type": "boolean" },
        "yearsServing": { "type": "number" },
        "maritalStatus": { "type": "string", "enum": ["soltero", "casado"] },
        "bio": { "type": "string", "maxLength": 500 },
        "points": { "type": "number" },
        "level": { "type": "number" },
        "levelName": { "type": "string", "maxLength": 50 },
        "role": { "type": "string", "enum": ["user", "moderator", "admin", "superadmin"] },
        "isOfficialVerified": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 60 }
      },
      "required": ["id", "name", "username", "email", "points", "level", "role"]
    },
    "Post": {
      "title": "Post",
      "description": "Publicación social con testimonios, fotos y reacciones cristianas",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorUsername": { "type": "string", "maxLength": 60 },
        "authorAvatar": { "type": "string", "maxLength": 500 },
        "authorPoints": { "type": "number" },
        "authorIsOfficial": { "type": "boolean" },
        "authorChurch": { "type": "string", "maxLength": 150 },
        "content": { "type": "string", "maxLength": 3000 },
        "imageUrl": { "type": "string" },
        "videoUrl": { "type": "string" },
        "mediaType": { "type": "string", "enum": ["image", "video"] },
        "bibleVerse": { "type": "string", "maxLength": 500 },
        "viewsCount": { "type": "number" },
        "sharesCount": { "type": "number" },
        "isOfficial": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 60 }
      },
      "required": ["id", "authorId", "authorName", "content", "createdAt"]
    },
    "Challenge": {
      "title": "Challenge",
      "description": "Reto espiritual juvenil verificable",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 1500 },
        "category": { "type": "string", "maxLength": 80 },
        "difficulty": { "type": "string", "enum": ["Fácil", "Medio", "Difícil", "Épico"] },
        "points": { "type": "number" },
        "participantsCount": { "type": "number" },
        "deadline": { "type": "string", "maxLength": 30 },
        "requiredEvidence": { "type": "string", "maxLength": 500 },
        "icon": { "type": "string", "maxLength": 20 },
        "imageUrl": { "type": "string", "maxLength": 500 },
        "isOfficial": { "type": "boolean" }
      },
      "required": ["id", "title", "description", "points", "difficulty"]
    },
    "ChallengeSubmission": {
      "title": "ChallengeSubmission",
      "description": "Evidencia fotográfica o testimonial de reto completado para revisión",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "challengeId": { "type": "string", "maxLength": 128 },
        "challengeTitle": { "type": "string", "maxLength": 200 },
        "challengePoints": { "type": "number" },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "userUsername": { "type": "string", "maxLength": 60 },
        "userAvatar": { "type": "string", "maxLength": 500 },
        "userChurch": { "type": "string", "maxLength": 150 },
        "date": { "type": "string", "maxLength": 30 },
        "approximateLocation": { "type": "string", "maxLength": 200 },
        "commentReflection": { "type": "string", "maxLength": 2000 },
        "mediaType": { "type": "string", "enum": ["photo", "video"] },
        "mediaUrl": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "more_info"] },
        "adminFeedback": { "type": "string", "maxLength": 500 },
        "submittedAt": { "type": "string", "maxLength": 60 }
      },
      "required": ["id", "challengeId", "userId", "userName", "status", "commentReflection"]
    },
    "Comment": {
      "title": "Comment",
      "description": "Comentario juvenil en publicación con stickers y texto",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "postId": { "type": "string", "maxLength": 128 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorUsername": { "type": "string", "maxLength": 60 },
        "authorAvatar": { "type": "string", "maxLength": 500 },
        "content": { "type": "string", "maxLength": 1000 },
        "sticker": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "maxLength": 60 },
        "likes": { "type": "number" },
        "parentId": { "type": "string", "maxLength": 128 },
        "replyToUsername": { "type": "string", "maxLength": 60 },
        "replyToUserId": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "postId", "authorId", "authorName", "content", "createdAt"]
    },
    "Reaction": {
      "title": "Reaction",
      "description": "Reacción cristiana juvenil a una publicación",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "postId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "type": { "type": "string", "enum": ["amen", "aleluya", "gloriaDios", "diosEsBueno", "bendiciones", "estoyOrando", "meInspiro"] },
        "createdAt": { "type": "string", "maxLength": 60 }
      },
      "required": ["id", "postId", "userId", "type", "createdAt"]
    },
    "Story": {
      "title": "Story",
      "description": "Historia efímera espiritual con duración de 24 horas",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorUsername": { "type": "string", "maxLength": 60 },
        "authorAvatar": { "type": "string", "maxLength": 500 },
        "category": { "type": "string", "maxLength": 60 },
        "mediaUrl": { "type": "string" },
        "mediaType": { "type": "string", "enum": ["image", "video"] },
        "textContent": { "type": "string", "maxLength": 500 },
        "bibleVerse": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 60 },
        "expiresAt": { "type": "string", "maxLength": 60 },
        "viewsCount": { "type": "number" }
      },
      "required": ["id", "authorId", "authorName", "category", "createdAt"]
    },
    "Message": {
      "title": "Message",
      "description": "Mensaje de chat directo o grupal cristiano",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "conversationId": { "type": "string", "maxLength": 128 },
        "senderId": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 100 },
        "senderAvatar": { "type": "string", "maxLength": 500 },
        "content": { "type": "string", "maxLength": 2000 },
        "mediaUrl": { "type": "string", "maxLength": 500 },
        "sticker": { "type": "string", "maxLength": 100 },
        "isVoiceNote": { "type": "boolean" },
        "voiceDuration": { "type": "string", "maxLength": 20 },
        "timestamp": { "type": "string", "maxLength": 60 }
      },
      "required": ["id", "conversationId", "senderId", "senderName", "content", "timestamp"]
    },
    "Group": {
      "title": "Group",
      "description": "Grupo o comunidad de jóvenes adventistas por ministerio o zona",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 1000 },
        "avatar": { "type": "string", "maxLength": 500 },
        "category": { "type": "string", "maxLength": 60 },
        "leaderId": { "type": "string", "maxLength": 128 },
        "leaderName": { "type": "string", "maxLength": 100 },
        "isPublic": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 60 }
      },
      "required": ["id", "name", "category", "leaderId", "leaderName", "createdAt"]
    },
    "Event": {
      "title": "Event",
      "description": "Convocatoria o campamento juvenil adventista",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "category": { "type": "string", "maxLength": 60 },
        "date": { "type": "string", "maxLength": 100 },
        "time": { "type": "string", "maxLength": 50 },
        "city": { "type": "string", "maxLength": 100 },
        "country": { "type": "string", "maxLength": 100 },
        "venue": { "type": "string", "maxLength": 150 },
        "organizer": { "type": "string", "maxLength": 150 },
        "isOfficialSource": { "type": "boolean" },
        "officialSourceUrl": { "type": "string", "maxLength": 500 },
        "officialOrganization": { "type": "string", "maxLength": 150 },
        "interestedCount": { "type": "number" },
        "attendingCount": { "type": "number" },
        "imageUrl": { "type": "string", "maxLength": 500 },
        "scope": { "type": "string", "enum": ["local", "ciudad", "nacional", "internacional"] }
      },
      "required": ["id", "title", "description", "date", "city", "organizer"]
    },
    "Badge": {
      "title": "Badge",
      "description": "Insignia o galardón desbloqueable por retos y servicio",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "icon": { "type": "string", "maxLength": 50 },
        "description": { "type": "string", "maxLength": 500 },
        "category": { "type": "string", "enum": ["reto", "servicio", "fe", "puntos", "liderazgo"] },
        "unlockedAt": { "type": "string", "maxLength": 60 }
      },
      "required": ["id", "name", "icon", "description", "category"]
    },
    "Achievement": {
      "title": "Achievement",
      "description": "Logro completado y certificado por un usuario",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "badgeId": { "type": "string", "maxLength": 128 },
        "badgeName": { "type": "string", "maxLength": 100 },
        "badgeIcon": { "type": "string", "maxLength": 50 },
        "description": { "type": "string", "maxLength": 500 },
        "pointsAwarded": { "type": "number" },
        "unlockedAt": { "type": "string", "maxLength": 60 }
      },
      "required": ["id", "userId", "badgeId", "badgeName", "pointsAwarded", "unlockedAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Notificación instantánea de actividad social o retos",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "maxLength": 50 },
        "title": { "type": "string", "maxLength": 150 },
        "message": { "type": "string", "maxLength": 500 },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 60 },
        "pointsAwarded": { "type": "number" }
      },
      "required": ["id", "type", "title", "message", "read", "createdAt"]
    },
    "Report": {
      "title": "Report",
      "description": "Reporte de contenido o usuario para moderación",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "reporterId": { "type": "string", "maxLength": 128 },
        "targetType": { "type": "string", "enum": ["post", "user", "comment", "submission"] },
        "targetId": { "type": "string", "maxLength": 128 },
        "reason": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["pending", "resolved", "dismissed"] },
        "createdAt": { "type": "string", "maxLength": 60 },
        "reviewedBy": { "type": "string", "maxLength": 100 },
        "resolutionNotes": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "reporterId", "targetType", "targetId", "reason", "status", "createdAt"]
    },
    "OfficialSource": {
      "title": "OfficialSource",
      "description": "Organización o canal adventista oficial verificado",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 150 },
        "organization": { "type": "string", "maxLength": 150 },
        "region": { "type": "string", "maxLength": 100 },
        "websiteUrl": { "type": "string", "maxLength": 500 },
        "logo": { "type": "string", "maxLength": 500 },
        "verified": { "type": "boolean" },
        "description": { "type": "string", "maxLength": 1000 },
        "lastUpdated": { "type": "string", "maxLength": 60 },
        "eventCount": { "type": "number" }
      },
      "required": ["id", "name", "organization", "websiteUrl", "verified"]
    },
    "News": {
      "title": "News",
      "description": "Noticias juveniles cristianas e información adventista oficial",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "summary": { "type": "string", "maxLength": 500 },
        "content": { "type": "string", "maxLength": 5000 },
        "sourceName": { "type": "string", "maxLength": 100 },
        "sourceUrl": { "type": "string", "maxLength": 500 },
        "category": { "type": "string", "maxLength": 60 },
        "publishedAt": { "type": "string", "maxLength": 60 },
        "imageUrl": { "type": "string", "maxLength": 500 },
        "verified": { "type": "boolean" }
      },
      "required": ["id", "title", "summary", "content", "sourceName", "publishedAt"]
    },
    "Channel": {
      "title": "Channel",
      "description": "Canales y contenido audiovisual cristiano y adventista",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 60 },
        "creator": { "type": "string", "maxLength": 100 },
        "thumbnail": { "type": "string", "maxLength": 500 },
        "duration": { "type": "string", "maxLength": 30 },
        "views": { "type": "string", "maxLength": 50 },
        "verifiedOfficial": { "type": "boolean" },
        "url": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "title", "creator", "category", "url"]
    },
    "Game": {
      "title": "Game",
      "description": "Juego bíblico y trivia juvenil gamificada",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 1000 },
        "category": { "type": "string", "maxLength": 60 },
        "difficulty": { "type": "string", "enum": ["Fácil", "Medio", "Difícil"] },
        "questionsCount": { "type": "number" },
        "pointsReward": { "type": "number" },
        "icon": { "type": "string", "maxLength": 50 },
        "active": { "type": "boolean" }
      },
      "required": ["id", "title", "category", "difficulty", "pointsReward"]
    },
    "GameScore": {
      "title": "GameScore",
      "description": "Puntaje y registro de partida en juego bíblico",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "gameId": { "type": "string", "maxLength": 128 },
        "gameTitle": { "type": "string", "maxLength": 150 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "userAvatar": { "type": "string", "maxLength": 500 },
        "score": { "type": "number" },
        "pointsAwarded": { "type": "number" },
        "correctAnswers": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "playedAt": { "type": "string", "maxLength": 60 }
      },
      "required": ["id", "gameId", "userId", "score", "pointsAwarded", "playedAt"]
    },
    "PrayerRequest": {
      "title": "PrayerRequest",
      "description": "Petición de oración comunitaria juvenil",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorUsername": { "type": "string", "maxLength": 60 },
        "authorAvatar": { "type": "string", "maxLength": 500 },
        "authorChurch": { "type": "string", "maxLength": 150 },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 1500 },
        "isAnswered": { "type": "boolean" },
        "testimony": { "type": "string", "maxLength": 2000 },
        "prayingCount": { "type": "number" },
        "category": { "type": "string", "enum": ["salud", "familia", "mision", "estudios", "espiritual"] },
        "createdAt": { "type": "string", "maxLength": 60 }
      },
      "required": ["id", "authorId", "authorName", "title", "description", "category"]
    },
    "Testimonial": {
      "title": "Testimonial",
      "description": "Testimonio o respuesta a la oración compartida con la comunidad",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorUsername": { "type": "string", "maxLength": 60 },
        "authorAvatar": { "type": "string", "maxLength": 500 },
        "authorChurch": { "type": "string", "maxLength": 150 },
        "title": { "type": "string", "maxLength": 200 },
        "story": { "type": "string", "maxLength": 3000 },
        "category": { "type": "string", "maxLength": 60 },
        "date": { "type": "string", "maxLength": 50 },
        "amenCount": { "type": "number" }
      },
      "required": ["id", "authorId", "authorName", "title", "story"]
    }
  },
  "firestore": {
