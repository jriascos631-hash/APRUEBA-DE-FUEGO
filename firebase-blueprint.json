    },
    "/groups/{groupId}": {
      "schema": "Group",
      "description": "Grupos y ministerios juveniles cristianos"
    },
    "/events/{eventId}": {
      "schema": "Event",
      "description": "Eventos y camporees adventistas certificados"
    },
    "/badges/{badgeId}": {
      "schema": "Badge",
      "description": "Insignias y medallas disponibles"
    },
    "/achievements/{achievementId}": {
      "schema": "Achievement",
      "description": "Logros desbloqueados por los usuarios"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Notificaciones recibidas por los usuarios"
    },
    "/reports/{reportId}": {
      "schema": "Report",
      "description": "Reportes enviados al panel de moderación y seguridad"
    },
    "/official_sources/{sourceId}": {
      "schema": "OfficialSource",
      "description": "Fuentes y organizaciones adventistas oficiales verificadas"
    },
    "/news/{newsId}": {
      "schema": "News",
      "description": "Noticias juveniles cristianas e información adventista oficial"
    },
    "/channels/{channelId}": {
      "schema": "Channel",
      "description": "Canales audiovisuales adventistas de música y predicación"
    },
    "/games/{gameId}": {
      "schema": "Game",
      "description": "Juegos bíblicos y dinámicas interactivas"
    },
    "/game_scores/{scoreId}": {
      "schema": "GameScore",
      "description": "Registro de partidas y puntuaciones de juegos bíblicos"
    },
    "/prayers/{prayerId}": {
      "schema": "PrayerRequest",
      "description": "Peticiones de oración comunitaria"
    },
    "/testimonials/{testimonialId}": {
      "schema": "Testimonial",
      "description": "Muro de testimonios y respuestas a oraciones"
    }
  }
}
